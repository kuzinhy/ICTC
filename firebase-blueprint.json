{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile inside the ICTC platform",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name" },
        "role": { "type": "string", "enum": ["Admin", "Creator", "Member"], "description": "User permissions role" },
        "avatarUrl": { "type": "string", "description": "Avatar URL" },
        "joinedDate": { "type": "string", "description": "ISO date string of joining" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "DesignFile": {
      "title": "DesignFile",
      "description": "Contributed Slide PPTX, report document, or UI design template",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "driveUrl": { "type": "string" },
        "previewUrl": { "type": "string" },
        "tags": { "type": "array" },
        "downloadsCount": { "type": "number" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] }
      },
      "required": ["id", "title", "description", "category", "fileType", "driveUrl", "authorId", "status"]
    },
    "AIPrompt": {
      "title": "AIPrompt",
      "description": "Smart prompt optimized using Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "rawPrompt": { "type": "string", "maxLength": 2000 },
        "optimizedPrompt": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string" },
        "toolType": { "type": "string" },
        "previewImageUrl": { "type": "string" },
        "tags": { "type": "array" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] }
      },
      "required": ["id", "title", "rawPrompt", "optimizedPrompt", "category", "toolType", "authorId", "status"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global administration parameters",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteDescription": { "type": "string" },
        "driveDesignFolder": { "type": "string" },
        "drivePromptFolder": { "type": "string" },
        "allowPublicUploads": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "defaultAIModel": { "type": "string" }
      },
      "required": ["siteName", "driveDesignFolder", "drivePromptFolder"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Registered platform users keyed by authenticatable userId"
    },
    "designs/{designId}": {
      "schema": "DesignFile",
      "description": "Design resource items"
    },
    "prompts/{promptId}": {
      "schema": "AIPrompt",
      "description": "Optimized design generative prompts"
    },
    "systemConfig/global": {
      "schema": "SystemConfig",
      "description": "Single configuration record for site tuning"
    }
  }
}
