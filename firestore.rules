rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getIncomingData() {
      return request.resource.data;
    }

    function getExistingData() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'nguyenhuy.thudaumot@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    // Entity validator blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role'])
        && data.id is string
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.role in ['Admin', 'Creator', 'Member'];
    }

    function isValidDesign(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'fileType', 'authorId', 'status'])
        && data.id is string
        && data.title is string
        && data.title.size() <= 200
        && data.status in ['Approved', 'Pending', 'Rejected'];
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['id', 'title', 'rawPrompt', 'category', 'toolType', 'authorId', 'status'])
        && data.id is string
        && data.title is string
        && data.title.size() <= 200
        && data.rawPrompt is string
        && data.status in ['Approved', 'Pending', 'Rejected'];
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['id', 'title', 'summary', 'category', 'author', 'status'])
        && data.id is string
        && data.title is string
        && data.title.size() <= 300
        && data.author is string
        && data.status in ['Published', 'Draft', 'Pending'];
    }

    function isValidFont(data) {
      return data.keys().hasAll(['id', 'name', 'category'])
        && data.id is string
        && data.name is string;
    }

    function isValidConfig(data) {
      return data.keys().hasAll(['siteName'])
        && data.siteName is string;
    }

    // Match rules for users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(getIncomingData());
      allow update: if isSignedIn() && (isAdmin() || (isOwner(userId) && isValidUser(getIncomingData())));
      allow delete: if isAdmin();
    }

    // Match rules for design templates
    match /designs/{designId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidDesign(getIncomingData()) && getIncomingData().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          getExistingData().authorId == request.auth.uid 
          && getIncomingData().authorId == request.auth.uid 
          && isValidDesign(getIncomingData())
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && getExistingData().authorId == request.auth.uid);
    }

    // Match rules for AI prompts
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPrompt(getIncomingData()) && getIncomingData().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          getExistingData().authorId == request.auth.uid 
          && getIncomingData().authorId == request.auth.uid 
          && isValidPrompt(getIncomingData())
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && getExistingData().authorId == request.auth.uid);
    }

    // Match rules for Articles
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidArticle(getIncomingData());
      allow update: if isSignedIn() && (
        isAdmin() || (
          getExistingData().authorId == request.auth.uid
          && isValidArticle(getIncomingData())
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && getExistingData().authorId == request.auth.uid);
    }

    // Match rules for Fonts
    match /fonts/{fontId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Match rules for system global config
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin() && isValidConfig(getIncomingData());
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}

