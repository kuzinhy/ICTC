rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getIncomingData() {
      return request.resource.data;
    }

    function getExistingData() {
      return resource.data;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'Admin';
    }

    // Entity validator blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'joinedDate'])
        && data.id is string
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.role in ['Admin', 'Creator', 'Member'];
    }

    function isValidDesign(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'category', 'fileType', 'driveUrl', 'authorId', 'status'])
        && data.id is string
        && data.title is string
        && data.title.size() <= 150
        && data.description is string
        && data.description.size() <= 1000
        && data.driveUrl is string
        && data.status in ['Approved', 'Pending', 'Rejected'];
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['id', 'title', 'rawPrompt', 'optimizedPrompt', 'category', 'toolType', 'authorId', 'status'])
        && data.id is string
        && data.title is string
        && data.title.size() <= 150
        && data.rawPrompt is string
        && data.rawPrompt.size() <= 2000
        && data.optimizedPrompt is string
        && data.optimizedPrompt.size() <= 3000
        && data.status in ['Approved', 'Pending', 'Rejected'];
    }

    function isValidConfig(data) {
      return data.keys().hasAll(['siteName', 'driveDesignFolder', 'drivePromptFolder'])
        && data.siteName is string
        && data.driveDesignFolder is string
        && data.drivePromptFolder is string;
    }

    // Match rules for users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(getIncomingData()) && getIncomingData().role != 'Admin';
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(getIncomingData()) && getIncomingData().role == getExistingData().role;
      allow delete: if isAdmin();
    }

    // Match rules for design templates
    match /designs/{designId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidDesign(getIncomingData()) && getIncomingData().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          getExistingData().authorId == request.auth.uid 
          && getIncomingData().authorId == request.auth.uid 
          && getIncomingData().status == getExistingData().status
          && isValidDesign(getIncomingData())
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && getExistingData().authorId == request.auth.uid);
    }

    // Match rules for AI prompts
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPrompt(getIncomingData()) && getIncomingData().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          getExistingData().authorId == request.auth.uid 
          && getIncomingData().authorId == request.auth.uid 
          && getIncomingData().status == getExistingData().status
          && isValidPrompt(getIncomingData())
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && getExistingData().authorId == request.auth.uid);
    }

    // Match rules for system global config
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin() && isValidConfig(getIncomingData());
    }
  }
}
